# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Xcode
*.xcodeproj/
*.xcworkspace/
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
Package.resolved
.build/
Packages/

# CocoaPods
Pods/

# Generated by xcodegen
*.xcodeproj
generated/

# Build output
build/
DerivedData/
dist/

# Code coverage
*.profraw

# Swift module artifacts
*.swiftmodule
*.abi.json
*.swiftinterface

# Large binary files (use Asset Catalog instead)
*.icns

# Secrets (prevent accidental commit)
*.secret
*.key
*.pem
*.p12
*.env
.env.*

# Editor config (personal, not project)
.vscode/
.idea/

# Codegraph index (local)
.codegraph/

# Code review artifacts (dev process, not source)
codereview/

# Development planning docs (working documents, not polished docs)
plans/

# Release template (one-time process doc)
RELEASE_TEMPLATE.md

# Screenshot scripts and captures (local dev artifacts)
docs/screenshots/
!docs/screenshots/
!docs/screenshots/**/
!docs/screenshots/**/*.png

# Bundled git (populated by scripts/fetch_git.sh; only .gitkeep tracked)
PanghuGit/Resources/git/*
!PanghuGit/Resources/git/.gitkeep